# Local development only (npm run dev). NEVER commit real values. Staging/production values live in
# /opt/fitness[-staging]/.env on the VPS, created by the bootstrap script.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitness
PUBLIC_ORIGIN=http://localhost:3200
PORT=3200
MEDIA_DIR=/tmp/fitness-media
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info
# Screenshot reading (optional; without it every screenshot goes to manual review). Server-side only.
ANTHROPIC_API_KEY=
FITNESS_SCHEDULER_ENABLED=false
