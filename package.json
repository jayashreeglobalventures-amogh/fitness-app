{
  "name": "fitness-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fitness app: reusable challenge platform (first challenge: Calamari). Architecture follows AaryaShree IMS.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev": "tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "cli": "tsx src/cli.ts",
    "build:server": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/src/db/migrations',{recursive:true})\"",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/src/server.js",
    "dev:local": "tsx scripts/dev-local.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@node-rs/argon2": "^2.2.2",
    "@sinclair/typebox": "^0.34.52",
    "@tesseract.js-data/eng": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true,
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true,
    "fsevents@2.3.3": false,
    "tesseract.js@7.0.0": false
  }
}
